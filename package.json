{
  "name": "multifs",
  "version": "0.0.0",
  "description": "A runtime-agnostic package to manipulate filesystem-like environments through a unified interface.",
  "homepage": "https://github.com/KTrain5169/multifs#readme",
  "bugs": {
    "url": "https://github.com/KTrain5169/multifs/issues"
  },
  "license": "MIT",
  "author": "KTrain5369",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTrain5169/multifs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./drivers/aws": "./dist/drivers/aws.mjs",
    "./drivers/cloudflare": "./dist/drivers/cloudflare.mjs",
    "./drivers/memory": "./dist/drivers/memory.mjs",
    "./drivers/netlify": "./dist/drivers/netlify.mjs",
    "./drivers/node": "./dist/drivers/node.mjs",
    "./drivers/vercel": "./dist/drivers/vercel.mjs",
    "./types": "./dist/types.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "chokidar": "^5.0.0",
    "memfs": "^4.68.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "chokidar": "^5.0.0",
    "memfs": "^4.68.1"
  },
  "peerDependenciesMeta": {
    "chokidar": {
      "optional": true
    },
    "memfs": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  }
}
